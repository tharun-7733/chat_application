# =============================================================================
# NexChat — Root .env.example
# Copy this to .env and fill in your real values.
# =============================================================================

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=Cluster0
REDIS_URL=rediss://default:TOKEN@your-db.upstash.io:6379
JWT_SECRET=generate-a-long-random-secret-here-min-32-chars
INTERNAL_SECRET=another-random-secret
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
