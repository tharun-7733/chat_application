# ─────────────────────────────────────────────────────────────────────────────
# NexChat Node.js Service — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local dev:  mongodb://localhost:27017/nexchat
# Docker:     mongodb://mongodb:27017/nexchat
# Atlas:      mongodb+srv://user:pass@cluster.mongodb.net/nexchat
MONGODB_URI=mongodb://localhost:27017/nexchat

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev:  redis://localhost:6379
# Docker:     redis://redis:6379
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# ⚠️  MUST match the JWT_SECRET used by the Go WebSocket service.
#    Go validates tokens independently — any mismatch breaks WebSocket auth.
# Generate: openssl rand -base64 64
JWT_SECRET=nexchat-super-secret-key-replace-in-production-minimum-32-bytes

# Access token TTL in seconds (default: 900 = 15 minutes)
JWT_ACCESS_EXPIRY_SECONDS=900

# Refresh token TTL in seconds (default: 604800 = 7 days)
JWT_REFRESH_EXPIRY_SECONDS=604800

# ── Internal Service Auth ─────────────────────────────────────────────────────
# ⚠️  MUST match INTERNAL_SECRET in the Go WebSocket service.
#    Go sends this as X-Internal-Token on POST /api/internal/messages.
INTERNAL_SECRET=nexchat-internal-dev-secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# React dev server URL. Separate multiple origins with commas.
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Applied to auth endpoints (register, login) only.
# Maximum requests allowed per IP within the time window.
RATE_LIMIT_MAX=5
# Time window in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ── BCrypt ────────────────────────────────────────────────────────────────────
# MUST stay at 12 to match Java's BCryptPasswordEncoder(12)
# (passwords hashed in the old Java service must still verify in Node.js)
BCRYPT_SALT_ROUNDS=12
